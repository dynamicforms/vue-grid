{
  "name": "@dynamicforms/vue-grid",
  "private": false,
  "version": "0.3.1",
  "type": "module",
  "description": "High-performance virtual-scroll data grid for Vue 3 with sorting, filtering, and row selection.",
  "author": "Jure Erznožnik",
  "files": [
    "dist/*"
  ],
  "main": "dist/dynamicforms-vue-grid.umd.cjs",
  "module": "dist/dynamicforms-vue-grid.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/dynamicforms-vue-grid.umd.cjs",
      "import": "./dist/dynamicforms-vue-grid.js"
    },
    "./styles.css": "./dist/dynamicforms-vue-grid.css"
  },
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run --coverage",
    "lint": "eslint src && vue-tsc --noEmit",
    "test:e2e": "playwright test",
    "docs:dev": "npm run docs:dev -w docs",
    "docs:build": "npm run docs:build -w docs",
    "docs:preview": "npm run docs:preview -w docs"
  },
  "keywords": [
    "vue",
    "vue3",
    "grid",
    "data-grid",
    "datagrid",
    "table",
    "virtual-scroll",
    "sorting",
    "filtering",
    "selection",
    "dynamicforms"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynamicforms/vue-grid.git"
  },
  "bugs": {
    "url": "https://github.com/dynamicforms/vue-grid/issues"
  },
  "homepage": "https://docs.velis.si/dynamicforms/vue-grid",
  "peerDependencies": {
    "@dynamicforms/vue-forms": "^0.17.1",
    "@dynamicforms/vuetify-inputs": "^0.10.0",
    "@mdi/font": "^7.4.47",
    "@pdanpdan/virtual-scroll": "^0.10.3",
    "date-fns": "^4.1.0",
    "lodash-es": "^4.17.12",
    "natural-orderby": "^5.0.0",
    "vue": "^3.5.2",
    "vue-cached-icon": "^3.0.5",
    "vue-markdown-render": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.14.1",
    "@vitejs/plugin-vue": "^6",
    "@vitest/coverage-istanbul": "^4",
    "@vue/test-utils": "^2.2.4",
    "@vue/tsconfig": "^0.7.0",
    "eslint-config-velis": "^1.1.16",
    "jsdom": "^26.0.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "^5",
    "vite": "^8",
    "vite-plugin-dts": "^4",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^4",
    "vue-tsc": "^2"
  },
  "eslintConfig": {
    "extends": [
      "velis"
    ],
    "overrides": [
      {
        "files": [
          "**/*.spec.ts"
        ],
        "rules": {
          "vue/one-component-per-file": "off"
        }
      }
    ],
    "ignorePatterns": [
      "dist/*",
      "coverage/*",
      "node_modules/*",
      "docs/*",
      "vite.config.ts"
    ]
  }
}
